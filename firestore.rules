rules_version = '2';

/**
 * Day 1 stub — intent only. Full role-based enforcement (farmer owns own
 * data, officer scoped to assigned center, admin broad access) is
 * implemented on Day 4 once Firebase Authentication and profiles/roles
 * are live. Until then this denies all client access by default so no
 * data is exposed before rules are finished.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

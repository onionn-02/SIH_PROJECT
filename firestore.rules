rules_version = '2';

/**
 * Role-based access (CLAUDE.md §11, §12, §20).
 * - Farmers can only read their own profile/appointments/records/notifications.
 * - Officers are scoped to the single center on their profile
 *   (`assigned_center_id`) and can only move an appointment's status along
 *   the same transition graph enforced client-side in
 *   src/lib/validation/status-transitions.ts.
 * - Admins have broad access. The admin panel itself lands Day 5; these
 *   rules are already written for it so nothing has to change when it does.
 * - Center/schedule *creation* is admin/server-only. A farmer may
 *   self-book: create their own `appointments` doc (status SCHEDULED,
 *   against a published schedule), bump that schedule's `booked_count` by
 *   exactly 1 without exceeding capacity, and write the matching initial
 *   `status_history` entry + their own booking-confirmation notification —
 *   see src/services/booking.ts, which performs all of this atomically in
 *   one transaction.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    function isOfficerForCenter(centerId) {
      return isSignedIn() && myProfile().role == 'officer' && centerId in myProfile().assigned_center_ids;
    }

    function isValidStatusTransition(fromStatus, toStatus) {
      return
        (fromStatus == 'SCHEDULED' && toStatus in ['WAITING', 'CANCELLED']) ||
        (fromStatus == 'WAITING' && toStatus in ['CALLED', 'NO_SHOW', 'CANCELLED']) ||
        (fromStatus == 'CALLED' && toStatus in ['IN_PROGRESS', 'NO_SHOW', 'CANCELLED']) ||
        (fromStatus == 'IN_PROGRESS' && toStatus in ['COMPLETED', 'CANCELLED']);
    }

    function scheduleOf(scheduleId) {
      return get(/databases/$(database)/documents/procurement_schedules/$(scheduleId)).data;
    }

    /** Older schedule docs (seeded/admin-created before this field existed) count as 0 booked. */
    function bookedCountOf(scheduleData) {
      return ('booked_count' in scheduleData) ? scheduleData.booked_count : 0;
    }

    match /profiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      // Admin can update any profile (e.g. Admin -> Users assigning centers
      // to an officer). A user updating their own profile may never change
      // their own role or center assignment (self-escalation).
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.assigned_center_ids == resource.data.assigned_center_ids
      );
      allow delete: if false;
    }

    match /procurement_centers/{centerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /procurement_schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      // A farmer booking a slot bumps booked_count by exactly 1, never past
      // capacity, and touches no other field (src/services/booking.ts).
      allow update: if isSignedIn()
        && resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked_count', 'updated_at'])
        && request.resource.data.booked_count == bookedCountOf(resource.data) + 1
        && request.resource.data.booked_count <= resource.data.capacity;
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        resource.data.farmer_id == request.auth.uid ||
        isOfficerForCenter(resource.data.center_id) ||
        isAdmin()
      );
      // A farmer may only create an appointment for themselves, starting
      // SCHEDULED, against a schedule that is actually published and whose
      // center_id matches what they're claiming.
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.farmer_id == request.auth.uid &&
        request.resource.data.status == 'SCHEDULED' &&
        scheduleOf(request.resource.data.schedule_id).status == 'published' &&
        scheduleOf(request.resource.data.schedule_id).center_id == request.resource.data.center_id
      );
      allow update: if isAdmin() || (
        isOfficerForCenter(resource.data.center_id) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']) &&
        isValidStatusTransition(resource.data.status, request.resource.data.status)
      );
      allow delete: if false;
    }

    match /status_history/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.farmer_id == request.auth.uid ||
        isOfficerForCenter(get(/databases/$(database)/documents/appointments/$(resource.data.appointment_id)).data.center_id)
      );
      // A farmer may self-write only the very first "booked" audit entry for
      // their own appointment (src/services/booking.ts) — never any other
      // transition, which must go through an officer/admin.
      allow create: if isAdmin() ||
        isOfficerForCenter(get(/databases/$(database)/documents/appointments/$(request.resource.data.appointment_id)).data.center_id) ||
        (isSignedIn() &&
          request.resource.data.farmer_id == request.auth.uid &&
          request.resource.data.old_status == null &&
          request.resource.data.new_status == 'SCHEDULED');
      allow update, delete: if false;
    }

    match /procurement_records/{id} {
      allow read: if isSignedIn() && (
        resource.data.farmer_id == request.auth.uid ||
        isOfficerForCenter(resource.data.center_id) ||
        isAdmin()
      );
      allow create: if isAdmin() || isOfficerForCenter(request.resource.data.center_id);
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      // A farmer may create only a notification addressed to themselves —
      // used for their own booking confirmation (src/services/booking.ts).
      allow create: if isAdmin() || (isSignedIn() && myProfile().role == 'officer')
        || (isSignedIn() && request.resource.data.user_id == request.auth.uid);
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at']);
      allow delete: if false;
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (resource.data.farmer_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
